# [[Config]]
alias aliases="nvim ~/.bash_aliases"
alias bashup="source ~/.bashrc"
alias bashrc="nvim ~/.bashrc"

# [[Utils]]
alias r="rip"
alias n="nvim"
alias cl="clear"
alias cat="bat"
alias cd='z'
alias zz='zi'

# [[Directories]]
alias cd.="cd .."
alias cd-="cd -"
alias cd~="cd ~"
alias ls="eza"
alias grep="grep --color=auto"
alias l="yy"

# [[Git]]
alias lg="lazygit"

# [[Agents]]
alias c='claude'
alias cs4='claude --model claude-sonnet-4-6'
alias co4='claude --model claude-opus-4-6'
alias cs='claude --model claude-sonnet-5-5'
alias co='claude --model claude-opus-5-5'
alias ag='agent'
alias cur='agent'
alias kimi='kimicoder'
