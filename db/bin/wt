#!/usr/bin/env bash
set -euo pipefail

REPOS_DIR="${REPOS_DIR:-$HOME/ld}"

log()  { printf '\033[0;34m==>\033[0m %s\n' "$*"; }
ok()   { printf '\033[0;32m  ✓\033[0m %s\n' "$*"; }
warn() { printf '\033[0;33m  !\033[0m %s\n' "$*"; }
die()  { printf '\033[0;31mERROR:\033[0m %s\n' "$*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# wt setup — create a bare repo with a main worktree
# ---------------------------------------------------------------------------
cmd_setup() {
  local target="${1:-}"
  [[ -n "$target" ]] || die "Usage: wt setup <path-or-remote-url>"

  if [[ -d "$target" ]]; then
    setup_from_existing "$target"
  else
    setup_from_clone "$target"
  fi
}

install_pull_only_hook() {
  local worktree="$1"
  local gitdir
  gitdir="$(git -C "$worktree" rev-parse --git-dir)"
  mkdir -p "$gitdir/hooks"
  cat > "$gitdir/hooks/pre-push" <<'HOOK'
#!/usr/bin/env bash
echo "error: pushing from the main worktree is disabled."
echo "       use wt to create a feature branch."
exit 1
HOOK
  chmod +x "$gitdir/hooks/pre-push"
  ok "pull-only hook installed"
}

detect_default_branch() {
  local bare="$1"
  local branch
  branch="$(git -C "$bare" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null \
    | sed 's|origin/||')" || true
  if [[ -z "$branch" ]]; then
    # Fallback: try common names
    for candidate in main master; do
      if git -C "$bare" show-ref --verify --quiet "refs/remotes/origin/$candidate"; then
        branch="$candidate"
        break
      fi
    done
  fi
  [[ -n "$branch" ]] || die "Could not detect default branch"
  echo "$branch"
}

# List all non-default worktrees as repo/branch entries
list_feature_worktrees() {
  for dir in "$REPOS_DIR"/*/; do
    [[ -d "$dir" ]] || continue
    local name
    name="$(basename "$dir")"
    local bare="$dir/${name}.git"
    [[ -d "$bare" ]] || continue

    local default_branch
    default_branch="$(detect_default_branch "$bare" 2>/dev/null || true)"

    while IFS= read -r line; do
      local wt_path wt_branch
      wt_path="$(echo "$line" | awk '{print $1}')"
      wt_branch="$(echo "$line" | awk '{print $3}' | sed 's|^\[||;s|\]$||')"
      [[ -n "$wt_branch" ]] || continue
      [[ "$wt_branch" != "$default_branch" ]] || continue
      local wt_rel="${wt_path#$REPOS_DIR/$name/}"
      echo "${name}/${wt_rel}"
    done < <(git -C "$bare" worktree list 2>/dev/null | tail -n +2)
  done
}

setup_from_clone() {
  local remote="$1"
  local name
  name="$(basename "$remote" .git)"
  local wrapper="$REPOS_DIR/$name"
  local bare="$wrapper/${name}.git"

  [[ ! -d "$bare" ]] || die "Bare repo already exists: $bare"

  log "Cloning $remote (bare)"
  mkdir -p "$wrapper"
  git clone --bare "$remote" "$bare"

  git -C "$bare" config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'
  git -C "$bare" fetch origin
  ok "bare clone created, refspec fixed"

  local default_branch
  default_branch="$(detect_default_branch "$bare")"

  local main_wt="$wrapper/$default_branch"
  git -C "$bare" worktree add -b "$default_branch" "$main_wt" "origin/$default_branch"
  ok "worktree: $main_wt"

  install_pull_only_hook "$main_wt"

  log "Done: $wrapper"
  echo "    bare:     $bare"
  echo "    worktree: $main_wt (pull-only)"
}

setup_from_existing() {
  local repo
  repo="$(realpath "$1")"
  local name
  name="$(basename "$repo")"
  local wrapper="$repo"
  local bare="$wrapper/${name}.git"

  if [[ ! -d "$repo/.git" ]]; then
    if [[ -d "$bare" ]]; then
      # Already bare — ensure main worktree + hook exist
      local default_branch
      default_branch="$(detect_default_branch "$bare")"
      local main_wt="$wrapper/$default_branch"
      if [[ -d "$main_wt" ]]; then
        ok "Already converted: $name"
      else
        log "$name: creating missing $default_branch worktree"
        if git -C "$bare" show-ref --verify --quiet "refs/remotes/origin/$default_branch"; then
          git -C "$bare" worktree add "$main_wt" "$default_branch"
        else
          git -C "$bare" worktree add -b "$default_branch" "$main_wt" HEAD
        fi
        install_pull_only_hook "$main_wt"
        ok "$name: $main_wt created"
      fi
      return 0
    fi
    die "Not a git repo: $repo"
  fi

  # Refuse if dirty
  if [[ -n "$(git -C "$repo" status --porcelain 2>/dev/null)" ]]; then
    die "$name has uncommitted changes. Commit or stash first."
  fi

  local default_branch
  default_branch="$(git -C "$repo" symbolic-ref --short HEAD 2>/dev/null || echo "main")"
  local remote
  remote="$(git -C "$repo" remote get-url origin 2>/dev/null || true)"

  log "Converting $repo in-place"

  # Move .git to become bare repo
  mv "$repo/.git" "$bare"
  git -C "$bare" config core.bare true
  ok "converted to bare"

  # Fix fetch refspec if needed
  local current_fetch
  current_fetch="$(git -C "$bare" config remote.origin.fetch 2>/dev/null || true)"
  if [[ "$current_fetch" != "+refs/heads/*:refs/remotes/origin/*" ]]; then
    git -C "$bare" config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'
    ok "refspec fixed"
  fi

  # Create main worktree
  local main_wt="$wrapper/$default_branch"
  if git -C "$bare" show-ref --verify --quiet "refs/remotes/origin/$default_branch"; then
    git -C "$bare" worktree add "$main_wt" "$default_branch"
  else
    git -C "$bare" worktree add -b "$default_branch" "$main_wt" HEAD
  fi
  ok "worktree: $main_wt"

  install_pull_only_hook "$main_wt"

  # Remove old working tree files (everything except bare repo dir and worktree dir)
  log "Cleaning old working tree files"
  for item in "$wrapper"/*; do
    local base
    base="$(basename "$item")"
    if [[ "$base" == "${name}.git" ]] || [[ "$base" == "$default_branch" ]]; then
      continue
    fi
    rm -rf "$item"
  done
  # Also remove hidden files from old working tree (but not . and ..)
  for item in "$wrapper"/.[!.]*; do
    [[ -e "$item" ]] || continue
    rm -rf "$item"
  done
  ok "old working tree cleaned"

  log "Done: $wrapper"
  echo "    bare:     $bare"
  echo "    worktree: $main_wt (pull-only)"
  if [[ -n "$remote" ]]; then
    echo "    remote:   $remote"
  fi
  local stash_count
  stash_count="$(git -C "$main_wt" stash list 2>/dev/null | wc -l | tr -d ' ')"
  if [[ "$stash_count" -gt 0 ]]; then
    echo "    stashes:  $stash_count preserved"
  fi
}

# ---------------------------------------------------------------------------
# wt [open] — create worktree + tmux session for a feature
# ---------------------------------------------------------------------------
cmd_open() {
  local no_prefix=false
  local branch=""
  local REPOS=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-prefix) no_prefix=true; shift ;;
      *) if [[ -z "$branch" ]]; then branch="$1"; else REPOS+=("$1"); fi; shift ;;
    esac
  done

  # Repo selection via fzf if none given
  if [[ ${#REPOS[@]} -eq 0 ]]; then
    local repo_list=()
    for dir in "$REPOS_DIR"/*/; do
      [[ -d "$dir" ]] || continue
      local name
      name="$(basename "$dir")"
      if [[ -d "$dir/${name}.git" ]]; then
        repo_list+=("$name")
      fi
    done

    [[ ${#repo_list[@]} -gt 0 ]] || die "No bare repos found in $REPOS_DIR"

    local selected
    selected="$(printf '%s\n' "${repo_list[@]}" | fzf \
      --prompt='repo(s) > ' \
      --multi \
      --header='TAB to select multiple, ENTER to confirm' \
      --height=40%)" || die "No repo selected"

    mapfile -t REPOS <<< "$selected"
  fi

  # Worktree name
  if [[ -z "$branch" ]]; then
    printf 'Worktree name (e.g. 1234): '
    read -r branch
  fi
  [[ -n "$branch" ]] || die "Name required"
  branch="${branch#/}"

  # Git branch gets db/ prefix unless --no-prefix
  local git_branch="$branch"
  if ! "$no_prefix"; then
    git_branch="db/${branch}"
  fi

  # Create worktree + tmux session for each repo
  for repo_name in "${REPOS[@]}"; do
    repo_name="${repo_name// /}"
    [[ -n "$repo_name" ]] || continue

    local bare="$REPOS_DIR/$repo_name/${repo_name}.git"
    local worktree="$REPOS_DIR/$repo_name/$branch"
    local session="${repo_name}/${branch}"

    [[ -d "$bare" ]] || die "Bare repo not found: $bare — run 'wt setup' first"

    log "[$repo_name] Setting up $branch (branch: $git_branch)"

    # Create worktree
    if [[ -d "$worktree" ]]; then
      ok "worktree exists: $worktree"
    else
      local default_branch
      default_branch="$(detect_default_branch "$bare")"

      mkdir -p "$(dirname "$worktree")"

      if git -C "$bare" show-ref --verify --quiet "refs/heads/$git_branch"; then
        git -C "$bare" worktree add "$worktree" "$git_branch"
      else
        git -C "$bare" worktree add -b "$git_branch" "$worktree" "$default_branch"
      fi
      ok "worktree: $worktree"
    fi

    # Create tmux session
    if tmux has-session -t "=$session" 2>/dev/null; then
      ok "session exists: $session"
    else
      tmux new-session -d -s "$session" -c "$worktree"
      ok "session: $session"
    fi

    # Switch/attach
    if [[ -n "${TMUX:-}" ]]; then
      tmux switch-client -t "=$session"
    else
      tmux attach-session -t "=$session"
    fi
  done
}

# ---------------------------------------------------------------------------
# wt close — tear down worktree + tmux session
# ---------------------------------------------------------------------------
cmd_close() {
  local repo_name=""
  local git_branch=""
  local worktree=""

  # Try to detect from pwd
  local wt_root
  wt_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [[ -n "$wt_root" ]] && [[ "$wt_root" == "$REPOS_DIR"/* ]]; then
    git_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    worktree="$wt_root"
    local rel="${wt_root#$REPOS_DIR/}"
    repo_name="${rel%%/*}"
  fi

  # If we couldn't detect, fzf over worktrees from bare repos
  if [[ -z "$repo_name" ]] || [[ -z "$git_branch" ]]; then
    local worktrees
    worktrees="$(list_feature_worktrees)"
    [[ -n "$worktrees" ]] || die "No feature worktrees found"

    local selected
    selected="$(echo "$worktrees" | fzf \
      --prompt='close > ' \
      --header='Pick worktree to close' \
      --height=40%)" || die "No selection"

    repo_name="${selected%%/*}"
    local wt_rel="${selected#*/}"
    worktree="$REPOS_DIR/$repo_name/$wt_rel"
    git_branch="$(git -C "$worktree" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    [[ -n "$git_branch" ]] || die "Could not detect branch for $worktree"
  fi

  local bare="$REPOS_DIR/$repo_name/${repo_name}.git"
  # Session name matches the worktree path relative to repo dir
  local wt_rel="${worktree#$REPOS_DIR/$repo_name/}"
  local session="${repo_name}/${wt_rel}"

  [[ -d "$bare" ]] || die "Bare repo not found: $bare"

  # Confirm
  printf '\033[0;33m  ?\033[0m Close %s? [y/N] ' "$session"
  read -r confirm
  [[ "$confirm" =~ ^[Yy]$ ]] || die "Aborted"

  # Warn on uncommitted changes
  if [[ -d "$worktree" ]]; then
    if ! git -C "$worktree" diff --quiet 2>/dev/null || ! git -C "$worktree" diff --cached --quiet 2>/dev/null; then
      warn "Uncommitted changes in $worktree"
      printf '\033[0;33m  ?\033[0m Remove anyway? [y/N] '
      read -r confirm
      [[ "$confirm" =~ ^[Yy]$ ]] || die "Aborted"
    fi
  fi

  # Remove worktree
  if [[ -d "$worktree" ]]; then
    git -C "$bare" worktree remove --force "$worktree"
    ok "removed worktree: $worktree"
  fi

  # Clean up empty parent dirs
  local parent
  parent="$(dirname "$worktree")"
  while [[ "$parent" != "$REPOS_DIR/$repo_name" ]] && [[ -d "$parent" ]]; do
    rmdir "$parent" 2>/dev/null || break
    ok "cleaned: $parent"
    parent="$(dirname "$parent")"
  done

  # Optionally delete branch
  local default_branch
  default_branch="$(detect_default_branch "$bare")"
  if [[ "$git_branch" != "$default_branch" ]]; then
    printf '\033[0;33m  ?\033[0m Delete branch %s? [y/N] ' "$git_branch"
    read -r confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
      git -C "$bare" branch -D "$git_branch" && ok "deleted branch: $git_branch"
    fi
  fi

  # Kill tmux session
  if [[ -n "$session" ]] && tmux has-session -t "=$session" 2>/dev/null; then
    # Switch to last session if we're in the one being killed
    local current
    current="$(tmux display-message -p '#S' 2>/dev/null || true)"
    if [[ "$current" == "$session" ]]; then
      tmux switch-client -l 2>/dev/null || tmux switch-client -n 2>/dev/null || true
    fi
    tmux kill-session -t "=$session"
    ok "killed session: $session"
  fi

  log "Done."
}

# ---------------------------------------------------------------------------
# wt attach — create tmux session for an existing worktree
# ---------------------------------------------------------------------------
cmd_attach() {
  local worktrees
  worktrees="$(list_feature_worktrees)"
  [[ -n "$worktrees" ]] || die "No feature worktrees found"

  local selected
  selected="$(echo "$worktrees" | fzf \
    --prompt='attach > ' \
    --header='Pick worktree to attach' \
    --height=40%)" || die "No selection"

  local repo_name="${selected%%/*}"
  local branch="${selected#*/}"
  local worktree="$REPOS_DIR/$repo_name/$branch"
  local session="${repo_name}/${branch}"

  if tmux has-session -t "=$session" 2>/dev/null; then
    ok "session exists: $session"
  else
    tmux new-session -d -s "$session" -c "$worktree"
    ok "session: $session"
  fi

  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "=$session"
  else
    tmux attach-session -t "=$session"
  fi
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
case "${1:-}" in
  setup)
    shift
    cmd_setup "$@"
    ;;
  open)
    shift
    cmd_open "$@"
    ;;
  close)
    shift
    cmd_close "$@"
    ;;
  ls)
    shift
    cmd_attach "$@"
    ;;
  -h|--help)
    echo "Usage:"
    echo "  wt [name] [repo...]       Open feature worktree + tmux session"
    echo "                           Branch: db/<name> (use --no-prefix to skip)"
    echo "  wt ls                    Attach tmux session to existing worktree"
    echo "  wt close                 Close current or fzf-picked session"
    echo "  wt setup <path>          Convert existing repo to bare"
    echo "  wt setup <remote-url>    Clone remote as bare repo"
    echo ""
    echo "Env: REPOS_DIR (default: ~/ld)"
    ;;
  *)
    cmd_open "$@"
    ;;
esac
