#!/usr/bin/env bash
set -euo pipefail

# Load config if it exists
if [[ -f "$HOME/.config/.wt" ]]; then
  source "$HOME/.config/.wt"
fi

REPOS_DIR="${REPOS_DIR:-$HOME/code/launchdarkly}"
BRANCH_PREFIX="${BRANCH_PREFIX:-}"
AUTO_INSTALL_HOOK="${AUTO_INSTALL_HOOK:-true}"

log()  { printf '\033[0;34m==>\033[0m %s\n' "$*"; }
ok()   { printf '\033[0;32m  ✓\033[0m %s\n' "$*"; }
warn() { printf '\033[0;33m  !\033[0m %s\n' "$*"; }
die()  { printf '\033[0;31mERROR:\033[0m %s\n' "$*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Herdr helpers
#
# Herdr owns the terminal side of a worktree: `herdr worktree create/open`
# creates the git worktree *and* a workspace whose `worktree.checkout_path`
# points at it, so a worktree and its workspace stay linked without wt
# tracking any state of its own.
# ---------------------------------------------------------------------------
require_herdr() {
  command -v herdr >/dev/null 2>&1 || die "herdr not found in PATH"
  [[ "${HERDR_ENV:-}" == "1" ]] || die "not running inside a Herdr session — start 'herdr' first"
  command -v jq >/dev/null 2>&1 || die "jq not found in PATH"
}

# Run a herdr subcommand, die on API error, print the JSON response.
hd() {
  local out rc=0
  out="$(herdr "$@" 2>&1)" || rc=$?
  local err
  err="$(printf '%s' "$out" | jq -r '.error.message // empty' 2>/dev/null || true)"
  [[ -z "$err" ]] || die "herdr $1 $2: $err"
  [[ "$rc" -eq 0 ]] || die "herdr $1 $2 failed: $out"
  printf '%s' "$out"
}

# Workspace id whose worktree checkout is this path, or empty.
workspace_for_worktree() {
  hd workspace list \
    | jq -r --arg p "$1" '
        .result.workspaces[]
        | select(.worktree.checkout_path == $p)
        | .workspace_id' \
    | head -1
}

workspace_label() {
  hd workspace get "$1" | jq -r '.result.workspace.label // empty'
}

# Herdr names the implicitly-created bare-repo workspace "<repo>.git"; tidy it.
tidy_repo_workspace() {
  local bare="$1" repo_name="$2"
  local ws
  ws="$(workspace_for_worktree "$bare")"
  [[ -n "$ws" ]] || return 0
  [[ "$(workspace_label "$ws")" == "${repo_name}.git" ]] || return 0
  hd workspace rename "$ws" "$repo_name" >/dev/null
}

# Create the worktree and its workspace. Reuses an existing branch when present.
# Args: bare worktree git_branch base_branch label
worktree_create() {
  local bare="$1" worktree="$2" git_branch="$3" base="$4" label="$5"
  mkdir -p "$(dirname "$worktree")"
  hd worktree create \
    --cwd "$bare" \
    --branch "$git_branch" \
    --base "$base" \
    --path "$worktree" \
    --label "$label" \
    --focus \
    | jq -r '.result.workspace.workspace_id'
}

# Open (or reuse) the workspace for an existing worktree. Args: bare worktree label
worktree_open() {
  local bare="$1" worktree="$2" label="$3"
  local ws
  ws="$(workspace_for_worktree "$worktree")"
  if [[ -n "$ws" ]]; then
    hd workspace focus "$ws" >/dev/null
    echo "$ws"
    return 0
  fi
  hd worktree open \
    --cwd "$bare" \
    --path "$worktree" \
    --label "$label" \
    --focus \
    | jq -r '.result.workspace.workspace_id'
}

# ---------------------------------------------------------------------------
# wt setup — create a bare repo with a main worktree
# ---------------------------------------------------------------------------
cmd_setup() {
  local target="${1:-}"
  [[ -n "$target" ]] || die "Usage: wt setup <path-or-remote-url>"

  if [[ -d "$target" ]]; then
    setup_from_existing "$target"
  else
    setup_from_clone "$target"
  fi
}

install_pull_only_hook() {
  local worktree="$1"
  [[ "$AUTO_INSTALL_HOOK" == "true" ]] || return 0

  local gitdir
  gitdir="$(git -C "$worktree" rev-parse --git-dir)"
  mkdir -p "$gitdir/hooks"
  cat > "$gitdir/hooks/pre-push" <<'HOOK'
#!/usr/bin/env bash
echo "error: pushing from the main worktree is disabled."
echo "       use wt to create a feature branch."
exit 1
HOOK
  chmod +x "$gitdir/hooks/pre-push"
  ok "pull-only hook installed"
}

detect_default_branch() {
  local bare="$1"
  local branch
  branch="$(git -C "$bare" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null \
    | sed 's|origin/||')" || true
  if [[ -z "$branch" ]]; then
    # Fallback: try common names
    for candidate in main master; do
      if git -C "$bare" show-ref --verify --quiet "refs/remotes/origin/$candidate"; then
        branch="$candidate"
        break
      fi
    done
  fi
  [[ -n "$branch" ]] || die "Could not detect default branch"
  echo "$branch"
}

# Build workspace label: [group/]name[/repo]
make_workspace_label() {
  local name="$1" repo="$2" group="${3:-}" multi="${4:-false}"
  local label="$name"
  if [[ -n "$group" ]]; then
    label="${group}/${name}"
  fi
  if "$multi"; then
    label="${label}/${repo}"
  fi
  echo "$label"
}

# Generic fzf picker. Args: prompt. Always multi-select. Items via stdin.
pick() {
  fzf --prompt="$1 > " --multi --header='TAB to select multiple, ENTER to confirm' --height=40% || die "No selection"
}

# List all non-default worktrees as repo/wt_rel entries
list_feature_worktrees() {
  local dir name bare default_branch
  for dir in "$REPOS_DIR"/*/; do
    [[ -d "$dir" ]] || continue
    name="$(basename "$dir")"
    bare="$dir/${name}.git"
    [[ -d "$bare" ]] || continue

    default_branch="$(detect_default_branch "$bare" 2>/dev/null || true)"

    herdr worktree list --cwd "$bare" 2>/dev/null \
      | jq -r --arg repo "$name" \
              --arg prefix "$REPOS_DIR/$name/" \
              --arg default "$default_branch" '
          .result.worktrees[]?
          | select(.is_linked_worktree == true)
          | select((.branch // "") != "")
          | select((.branch | sub("^refs/heads/"; "")) != $default)
          | select(.path | startswith($prefix))
          | $repo + "/" + (.path | ltrimstr($prefix))' \
      || true
  done
}

setup_from_clone() {
  local remote="$1"
  local name
  name="$(basename "$remote" .git)"
  local wrapper="$REPOS_DIR/$name"
  local bare="$wrapper/${name}.git"

  [[ ! -d "$bare" ]] || die "Bare repo already exists: $bare"

  log "Cloning $remote (bare)"
  mkdir -p "$wrapper"
  git clone --bare "$remote" "$bare"

  git -C "$bare" config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'
  git -C "$bare" fetch origin
  ok "bare clone created, refspec fixed"

  local default_branch
  default_branch="$(detect_default_branch "$bare")"

  local main_wt="$wrapper/$default_branch"
  git -C "$bare" worktree add -b "$default_branch" "$main_wt" "origin/$default_branch"
  ok "worktree: $main_wt"

  install_pull_only_hook "$main_wt"

  log "Done: $wrapper"
  echo "    bare:     $bare"
  echo "    worktree: $main_wt (pull-only)"
}

setup_from_existing() {
  local repo
  repo="$(realpath "$1")"
  local name
  name="$(basename "$repo")"
  local wrapper="$repo"
  local bare="$wrapper/${name}.git"

  if [[ ! -d "$repo/.git" ]]; then
    if [[ -d "$bare" ]]; then
      # Already bare — ensure main worktree + hook exist
      local default_branch
      default_branch="$(detect_default_branch "$bare")"
      local main_wt="$wrapper/$default_branch"
      if [[ -d "$main_wt" ]]; then
        ok "Already converted: $name"
      else
        log "$name: creating missing $default_branch worktree"
        if git -C "$bare" show-ref --verify --quiet "refs/remotes/origin/$default_branch"; then
          git -C "$bare" worktree add "$main_wt" "$default_branch"
        else
          git -C "$bare" worktree add -b "$default_branch" "$main_wt" HEAD
        fi
        install_pull_only_hook "$main_wt"
        ok "$name: $main_wt created"
      fi
      return 0
    fi
    die "Not a git repo: $repo"
  fi

  # Refuse if dirty
  if [[ -n "$(git -C "$repo" status --porcelain 2>/dev/null)" ]]; then
    die "$name has uncommitted changes. Commit or stash first."
  fi

  local default_branch
  default_branch="$(git -C "$repo" symbolic-ref --short HEAD 2>/dev/null || echo "main")"
  local remote
  remote="$(git -C "$repo" remote get-url origin 2>/dev/null || true)"

  log "Converting $repo in-place"

  # Move .git to become bare repo
  mv "$repo/.git" "$bare"
  git -C "$bare" config core.bare true
  ok "converted to bare"

  # Fix fetch refspec if needed
  local current_fetch
  current_fetch="$(git -C "$bare" config remote.origin.fetch 2>/dev/null || true)"
  if [[ "$current_fetch" != "+refs/heads/*:refs/remotes/origin/*" ]]; then
    git -C "$bare" config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'
    ok "refspec fixed"
  fi

  # Create main worktree
  local main_wt="$wrapper/$default_branch"
  if git -C "$bare" show-ref --verify --quiet "refs/remotes/origin/$default_branch"; then
    git -C "$bare" worktree add "$main_wt" "$default_branch"
  else
    git -C "$bare" worktree add -b "$default_branch" "$main_wt" HEAD
  fi
  ok "worktree: $main_wt"

  install_pull_only_hook "$main_wt"

  # Remove old working tree files (everything except bare repo dir and worktree dir)
  log "Cleaning old working tree files"
  for item in "$wrapper"/*; do
    local base
    base="$(basename "$item")"
    if [[ "$base" == "${name}.git" ]] || [[ "$base" == "$default_branch" ]]; then
      continue
    fi
    rm -rf "$item"
  done
  # Also remove hidden files from old working tree (but not . and ..)
  for item in "$wrapper"/.[!.]*; do
    [[ -e "$item" ]] || continue
    rm -rf "$item"
  done
  ok "old working tree cleaned"

  log "Done: $wrapper"
  echo "    bare:     $bare"
  echo "    worktree: $main_wt (pull-only)"
  if [[ -n "$remote" ]]; then
    echo "    remote:   $remote"
  fi
  local stash_count
  stash_count="$(git -C "$main_wt" stash list 2>/dev/null | wc -l | tr -d ' ')"
  if [[ "$stash_count" -gt 0 ]]; then
    echo "    stashes:  $stash_count preserved"
  fi
}

# ---------------------------------------------------------------------------
# wt [open] — create worktree + herdr workspace for a feature
# ---------------------------------------------------------------------------
cmd_open() {
  require_herdr

  local no_prefix=false
  local group=""
  local branch=""
  local REPOS=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-prefix) no_prefix=true; shift ;;
      *) if [[ -z "$branch" ]]; then branch="$1"; else REPOS+=("$1"); fi; shift ;;
    esac
  done

  # Parse group from "group//name" syntax
  if [[ "$branch" == *"//"* ]]; then
    group="${branch%%//*}"
    branch="${branch#*//}"
  fi

  # Repo selection via fzf if none given
  if [[ ${#REPOS[@]} -eq 0 ]]; then
    local repo_list=()
    for dir in "$REPOS_DIR"/*/; do
      [[ -d "$dir" ]] || continue
      local name
      name="$(basename "$dir")"
      if [[ -d "$dir/${name}.git" ]]; then
        repo_list+=("$name")
      fi
    done

    [[ ${#repo_list[@]} -gt 0 ]] || die "No bare repos found in $REPOS_DIR"

    local selected
    selected="$(printf '%s\n' "${repo_list[@]}" | pick "repo")"
    mapfile -t REPOS <<< "$selected"
  fi

  # Worktree name
  if [[ -z "$branch" ]]; then
    printf 'Worktree name (e.g. 1234): '
    read -r branch
  fi
  [[ -n "$branch" ]] || die "Name required"
  branch="${branch#/}"

  # Git branch gets prefix unless --no-prefix
  local git_branch="$branch"
  if ! "$no_prefix" && [[ -n "$BRANCH_PREFIX" ]]; then
    git_branch="${BRANCH_PREFIX}${branch}"
  fi

  local multi=false
  [[ ${#REPOS[@]} -le 1 ]] || multi=true

  # Create worktree + workspace for each repo
  for repo_name in "${REPOS[@]}"; do
    repo_name="${repo_name// /}"
    [[ -n "$repo_name" ]] || continue

    local bare="$REPOS_DIR/$repo_name/${repo_name}.git"
    local worktree="$REPOS_DIR/$repo_name/$branch"
    local label
    label="$(make_workspace_label "$branch" "$repo_name" "$group" "$multi")"

    [[ -d "$bare" ]] || die "Bare repo not found: $bare — run 'wt setup' first"

    log "[$repo_name] Setting up $branch (branch: $git_branch)"

    local default_branch ws
    default_branch="$(detect_default_branch "$bare")"

    if [[ -d "$worktree" ]]; then
      ws="$(worktree_open "$bare" "$worktree" "$label")"
      ok "worktree exists: $worktree"
    else
      ws="$(worktree_create "$bare" "$worktree" "$git_branch" "$default_branch" "$label")"
      ok "worktree: $worktree"
    fi
    tidy_repo_workspace "$bare" "$repo_name"
    ok "workspace: $label ($ws)"

    # Seed node_modules via bifrost in a background tab if the hook script exists
    local seed_script="$REPOS_DIR/$repo_name/scripts/post-checkout-seed-node-modules.sh"
    if [[ -x "$seed_script" ]]; then
      local seed_pane
      seed_pane="$(hd tab create --workspace "$ws" --cwd "$worktree" --label seed --no-focus \
        | jq -r '.result.root_pane.pane_id')"
      hd pane run "$seed_pane" \
        "$seed_script 0000000000000000000000000000000000000000 $REPOS_DIR/$repo_name/$default_branch" >/dev/null
      ok "seeding node_modules in background tab ($seed_pane)"
    fi
  done
}

# ---------------------------------------------------------------------------
# wt close — tear down worktree + herdr workspace
# ---------------------------------------------------------------------------
# Close a single worktree by its full path
close_one() {
  local worktree="$1"
  local rel="${worktree#$REPOS_DIR/}"
  local repo_name="${rel%%/*}"
  local bare="$REPOS_DIR/$repo_name/${repo_name}.git"
  local wt_rel="${worktree#$REPOS_DIR/$repo_name/}"
  local git_branch
  git_branch="$(git -C "$worktree" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  local ws
  ws="$(workspace_for_worktree "$worktree" || true)"
  local display="$repo_name/$wt_rel"
  if [[ -n "$ws" ]]; then
    display="$(workspace_label "$ws")"
  fi

  [[ -d "$bare" ]] || { warn "Bare repo not found: $bare"; return 1; }

  # Warn on uncommitted changes
  local close_wt=false
  local delete_branch=false

  if [[ -d "$worktree" ]]; then
    if ! git -C "$worktree" diff --quiet 2>/dev/null || ! git -C "$worktree" diff --cached --quiet 2>/dev/null; then
      warn "Uncommitted changes in $display"
    fi
  fi

  # Combined prompt for close and branch delete
  local prompt_branch=""
  if [[ -n "$git_branch" ]]; then
    local default_branch
    default_branch="$(detect_default_branch "$bare" 2>/dev/null || true)"
    if [[ "$git_branch" != "$default_branch" ]]; then
      prompt_branch=" and branch $git_branch"
    fi
  fi

  printf '\033[0;33m  ?\033[0m Close worktree%s? [yy/yn/ny/nn/n] ' "$prompt_branch"
  read -r response

  # Parse response: first char = close worktree, second char = delete branch
  if [[ "${response:0:1}" =~ ^[Yy]$ ]]; then
    close_wt=true
  fi
  if [[ "${response:1:1}" =~ ^[Yy]$ ]] && [[ -n "$prompt_branch" ]]; then
    delete_branch=true
  fi

  # If first answer is no, skip
  [[ "$close_wt" == "true" ]] || { warn "Skipped $display"; return 0; }

  # Remove worktree. When herdr owns a workspace for it, one call removes the
  # checkout and closes the workspace together.
  if [[ -n "$ws" ]]; then
    hd worktree remove --workspace "$ws" --force >/dev/null
    ok "removed worktree + workspace: $display"
  elif [[ -d "$worktree" ]]; then
    git -C "$bare" worktree remove --force "$worktree"
    ok "removed worktree: $display"
  fi

  # Clean up empty parent dirs
  local parent
  parent="$(dirname "$worktree")"
  while [[ "$parent" != "$REPOS_DIR/$repo_name" ]] && [[ -d "$parent" ]]; do
    rmdir "$parent" 2>/dev/null || break
    parent="$(dirname "$parent")"
  done

  # Delete branch if requested
  if [[ "$delete_branch" == "true" ]]; then
    git -C "$bare" branch -D "$git_branch" && ok "deleted branch: $git_branch"
  fi
}

cmd_close() {
  require_herdr

  local targets=()

  # Try to detect from pwd
  local wt_root
  wt_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [[ -n "$wt_root" ]] && [[ "$wt_root" == "$REPOS_DIR"/* ]]; then
    targets+=("$wt_root")
  else
    # fzf picker (multi-select)
    local worktrees
    worktrees="$(list_feature_worktrees)"
    [[ -n "$worktrees" ]] || die "No feature worktrees found"

    local selected
    selected="$(echo "$worktrees" | pick "close")"

    while IFS= read -r entry; do
      local rn="${entry%%/*}"
      local wr="${entry#*/}"
      targets+=("$REPOS_DIR/$rn/$wr")
    done <<< "$selected"
  fi

  # Confirm
  for wt in "${targets[@]}"; do
    close_one "$wt"
  done

  log "Done."
}

# ---------------------------------------------------------------------------
# wt ls — open a herdr workspace for an existing worktree
# ---------------------------------------------------------------------------
cmd_attach() {
  require_herdr

  local worktrees
  worktrees="$(list_feature_worktrees)"
  [[ -n "$worktrees" ]] || die "No feature worktrees found"

  local selected
  selected="$(echo "$worktrees" | pick "open")"

  while IFS= read -r entry; do
    local repo_name="${entry%%/*}"
    local wt_rel="${entry#*/}"
    local worktree="$REPOS_DIR/$repo_name/$wt_rel"
    local bare="$REPOS_DIR/$repo_name/${repo_name}.git"

    local label ws
    label="$(make_workspace_label "$wt_rel" "$repo_name" "" false)"
    ws="$(worktree_open "$bare" "$worktree" "$label")"
    tidy_repo_workspace "$bare" "$repo_name"
    ok "workspace: $(workspace_label "$ws") ($ws)"
  done <<< "$selected"
}

# ---------------------------------------------------------------------------
# wt <github-pr-url> — check out a PR branch as a worktree + workspace
# ---------------------------------------------------------------------------
cmd_pr() {
  require_herdr

  local url="$1"
  local org repo_name pr_num
  org="$(echo "$url"       | sed -E 's|https://github.com/([^/]+)/.*|\1|')"
  repo_name="$(echo "$url" | sed -E 's|https://github.com/[^/]+/([^/]+)/.*|\1|')"
  pr_num="$(echo "$url"    | sed -E 's|.*/pull/([0-9]+).*|\1|')"

  local bare="$REPOS_DIR/$repo_name/${repo_name}.git"
  [[ -d "$bare" ]] || die "Repo not set up: $repo_name — run 'wt setup $url' first"

  log "Looking up PR #$pr_num in $org/$repo_name"
  local branch
  branch="$(gh pr view "$pr_num" --repo "$org/$repo_name" --json headRefName -q .headRefName)" \
    || die "Could not fetch PR #$pr_num — check 'gh auth status'"
  ok "branch: $branch"

  log "Fetching $branch"
  git -C "$bare" fetch origin "+refs/heads/${branch}:refs/heads/${branch}"
  ok "fetched"

  local worktree="$REPOS_DIR/$repo_name/$branch"
  local ws

  if [[ -d "$worktree" ]]; then
    ws="$(worktree_open "$bare" "$worktree" "$branch")"
    ok "worktree exists: $worktree"
  else
    local default_branch
    default_branch="$(detect_default_branch "$bare")"
    ws="$(worktree_create "$bare" "$worktree" "$branch" "$default_branch" "$branch")"
    ok "worktree: $worktree"
  fi
  tidy_repo_workspace "$bare" "$repo_name"
  ok "workspace: $branch ($ws)"
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
case "${1:-}" in
  setup)
    shift
    cmd_setup "$@"
    ;;
  open)
    shift
    cmd_open "$@"
    ;;
  close)
    shift
    cmd_close "$@"
    ;;
  ls)
    shift
    cmd_attach "$@"
    ;;
  https://github.com/*/pull/*)
    cmd_pr "$1"
    ;;
  -h|--help)
    echo "Usage:"
    echo "  wt [group//]name [repo...]"
    echo "                           Open feature worktree + herdr workspace"
    echo "                           Branch: db/<name> (use --no-prefix to skip)"
    echo "                           Workspace: [group/]name[/repo if multi]"
    echo "  wt ls                    Open herdr workspace for an existing worktree"
    echo "  wt close                 Close current or fzf-picked worktree + workspace"
    echo "  wt setup <path>          Convert existing repo to bare"
    echo "  wt setup <remote-url>    Clone remote as bare repo"
    echo "  wt <github-pr-url>       Check out a PR branch as a worktree"
    echo ""
    echo "Requires a running Herdr session (HERDR_ENV=1) plus jq for all"
    echo "commands except 'wt setup'."
    echo ""
    echo "Config: ~/.config/.wt"
    echo "  BRANCH_PREFIX            Branch name prefix (default: empty)"
    echo "  REPOS_DIR                Repository directory (default: ~/code/launchdarkly)"
    echo "  AUTO_INSTALL_HOOK        Install pre-push hook on setup (default: true)"
    ;;
  *)
    cmd_open "$@"
    ;;
esac
