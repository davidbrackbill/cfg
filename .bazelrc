# Share compiled artifacts across workspaces on this box, so a second
# checkout or worktree does not pay for a cold build. Bounded because a
# disk cache never collects by default. Added by termag-setup.
build --disk_cache=~/.cache/bazel-disk
build --experimental_disk_cache_gc_max_size=20G
build --experimental_disk_cache_gc_max_age=30d
# nogo cannot exec on linux/arm64; it is a validation action, so
# skipping it is safe. Added by termag-setup.
build --norun_validations
