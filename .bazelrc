# Bazel configuration file
# Generated by LaunchDarkly mac-setup bootstrap script

test --test_output=streamed

build --local_resources=memory=HOST_RAM*.5
build --local_resources=cpu=HOST_CPUS-2
build -c dbg --strip=never

# Share cache across worktrees
build --disk_cache=~/.cache/bazel-disk
build --repository_cache=~/.cache/bazel-repos

# Reuse sandbox directories to avoid setup/teardown overhead
build --experimental_reuse_sandbox_directories

