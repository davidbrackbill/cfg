behavior {
    theme "Kon"
    quickSelect {
        activateOnAnyCharacter false
    }
}

setup {
    actionBar []
    statusBar {
        showFreeSpace false
    }
}

keyBindings {
    "H" "core.go.up"
    "L" "core.open"
    "K" "core.move.up"
    "J" "core.move.down"
    "D" "core.trash"
    "R" "core.rename"
    "Shift+J" "core.move.half.page.down"
    "Shift+K" "core.move.half.page.up"
    "O" "core.new.file"
    "Shift+O" "core.new.folder"
    "Shift+P" "core.actions"
    "Y" "core.clipboard.copy"
    "P" "core.clipboard.paste"
}

