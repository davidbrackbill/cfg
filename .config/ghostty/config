# [[Shell]]
# Force homebrew bash (avoids macOS GUI session inheriting old $SHELL=/bin/bash 3.2)
# command = /opt/homebrew/bin/bash

# [[Appearance]]
theme=Catppuccin Mocha
font-family = Iosevka
font-size = 16
minimum-contrast = 5
background = #16161e
foreground = #e8ecfa
window-save-state = always

# [[Behavior]]
# No confirmation prompt when closing a tab/window
confirm-close-surface = false
notify-on-command-finish-action = bell
desktop-notifications = false

# Send ESC sequences for Option key so alt+f, alt+b, etc. work in tmux/bash vi-mode
macos-option-as-alt = true
macos-secure-input-indication = false
macos-titlebar-style = hidden
window-padding-y = 0
window-padding-balance = true

# [[Keybindings]]
# cmd+t sends ctrl+t (e.g. for tmux/herdr new-tab)
keybind = super+t=text:\x14
# cmd+w passed through as-is so herdr sees a distinct cmd+w (close_tab),
# not the same byte as ctrl+w (close_pane)
keybind = super+w=unbind
keybind = super+enter=unbind
# cmd+n passed through to herdr (new_workspace) instead of opening a new Ghostty window
keybind = super+n=unbind

# Cmd+f = tmux prefix (sends Alt+f)
keybind = super+f=text:\x1bf

# Cmd+key for tmux global shortcuts (sends Alt+key)
keybind = super+l=text:\x1bl
keybind = super+s=text:\x1bs
keybind = super+j=text:\x1bj
keybind = super+k=text:\x1bk
# cmd+/ passed through as-is for herdr's goto (was remapped to alt+/ for tmux copy-mode)
keybind = super+slash=unbind
keybind = super+period=text:\x1b.
keybind = super+comma=text:\x1b,
# cmd+shift+j passed through for herdr's previous_workspace (was Ghostty's
# default write_screen_file:paste,plain binding)
keybind = super+shift+j=unbind
# Cmd+Num = select window
keybind = super+1=text:\x1b1
keybind = super+2=text:\x1b2
keybind = super+3=text:\x1b3
keybind = super+4=text:\x1b4
keybind = super+5=text:\x1b5
keybind = super+6=text:\x1b6
keybind = super+7=text:\x1b7
keybind = super+8=text:\x1b8
keybind = super+9=text:\x1b9
keybind = super+0=text:\x1b0

# Cmd+Shift+Num = move window to position
keybind = super+shift+1=text:\x1b!
keybind = super+shift+2=text:\x1b@
keybind = super+shift+3=text:\x1b#
keybind = super+shift+4=text:\x1b$
keybind = super+shift+5=text:\x1b%
keybind = super+shift+6=text:\x1b^
keybind = super+shift+7=text:\x1b&
keybind = super+shift+8=text:\x1b*
keybind = super+shift+9=text:\x1b(
keybind = super+shift+0=text:\x1b)
