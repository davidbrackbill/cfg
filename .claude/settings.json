{
  "mcpServers": {
    "confluence": {
      "command": "npx",
      "args": ["-y", "@aashari/mcp-server-atlassian-confluence"]
    },
    "jira": {
      "command": "npx",
      "args": ["-y", "@aashari/mcp-server-atlassian-jira"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"]
    }
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); remaining=$(echo \"$input\" | jq -r '.context_window.remaining_percentage // empty'); [ -n \"$remaining\" ] && printf \"Context left: %.0f%%\" \"$remaining\" || echo \"Context left: --\""
  },
  "permissions": {
    "allow": [
      "Bash(mmdc:*)",
      "WebFetch",
      "WebSearch",
      "LS"
    ]
  },
  "hooks": {
    "Notification": [{ "matcher": "", "hooks": [{ "type": "command", "command": "printf '\\a' > /dev/tty" }] }],
    "Stop":         [{ "matcher": "", "hooks": [{ "type": "command", "command": "printf '\\a' > /dev/tty" }] }]
  }
}
