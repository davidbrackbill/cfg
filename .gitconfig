[user]
	# name and email loaded from ~/.git.env via GIT_AUTHOR_*/GIT_COMMITTER_* env vars
[core]
	autocrlf = input
	editor = nvim
	excludesfile = ~/.gitignore_global
[init]
	defaultBranch = main
[diff]
	context = 0

[url "git@github.com:"]
	insteadOf = https://github.com/
[pull]
	rebase = true
[push]
	autoSetupRemote = true

; Repo-specific maintenance registrations (added by `git maintenance start`)
; [maintenance]
; 	auto = false
; 	repo = /path
[include]
	path = ~/.gitconfig-local
