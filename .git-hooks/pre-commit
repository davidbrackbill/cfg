#!/bin/bash
# pre-commit: format Go and TypeScript files

# Get staged files
STAGED_FILES=$(git diff --cached --name-only)

# Format Go files
GO_FILES=$(echo "$STAGED_FILES" | grep '\.go$' | grep -v vendor)
if [ -n "$GO_FILES" ]; then
    echo "Running gofmt on staged Go files..."
    while IFS= read -r file; do
        gofmt -w "$file"
        git add "$file"
    done <<< "$GO_FILES"
fi

# Format TypeScript files
TS_FILES=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx)$')
if [ -n "$TS_FILES" ]; then
    echo "Running prettier on staged TypeScript files..."
    while IFS= read -r file; do
        npx prettier --write "$file"
        git add "$file"
    done <<< "$TS_FILES"
fi

exit 0
