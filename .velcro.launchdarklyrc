# Bootstrap-safe wrapper around ~/.launchdarklyrc.
# ~/.launchdarklyrc is regenerated by mac-setup/bootstrap — don't edit it directly.
# Put any overrides/optimisations here instead.

# Cache goenv init to avoid overhead on every shell start.
# The cache is invalidated whenever the goenv binary itself changes.
# Rehash calls are made conditional: shims only need rebuilding after `goenv install`.
_goenv_bin="${HOME}/.goenv/bin/goenv"
_goenv_cache="${HOME}/.cache/goenv_init.bash"
if [[ -x "$_goenv_bin" ]]; then
    if [[ ! -f "$_goenv_cache" || "$_goenv_bin" -nt "$_goenv_cache" ]]; then
        mkdir -p "${HOME}/.cache"
        # Patch both rehash calls to be conditional: skip if shims dir is newer than
        # versions dir, meaning no new Go version has been installed since last rehash.
        "$_goenv_bin" init - | sed \
            's|command goenv rehash 2>/dev/null|[[ "${GOENV_ROOT}/shims" -ot "${GOENV_ROOT}/versions" ]] \&\& command goenv rehash 2>/dev/null|g; s|goenv rehash --only-manage-paths|[[ "${GOENV_ROOT}/shims" -ot "${GOENV_ROOT}/versions" ]] \&\& goenv rehash --only-manage-paths|g' \
            > "$_goenv_cache"
    fi
    goenv() { [[ "$*" == "init -" ]] && { /bin/cat "$_goenv_cache"; return; }; command goenv "$@"; }
fi

# `go env -w GOPRIVATE=...` writes a persistent value to ~/.config/go/env.
# Skip if already set — check the file directly to avoid spawning a subprocess.
go() {
    if [[ "$*" == "env -w GOPRIVATE=github.com/launchdarkly" ]]; then
        grep -qs "GOPRIVATE=.*launchdarkly" \
            "${XDG_CONFIG_HOME:-$HOME/.config}/go/env" \
            "$HOME/Library/Application Support/go/env" 2>/dev/null && return
    fi
    command go "$@"
}

source ~/.launchdarklyrc

unset -f goenv go
unset _goenv_bin _goenv_cache
